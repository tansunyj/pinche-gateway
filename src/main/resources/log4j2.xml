<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN" monitorInterval="30">

    <Properties>
        <!-- 日志文件存放目录 -->
        <Property name="LOG_DIR">logs</Property>
        <!-- 日志文件名 -->
        <Property name="LOG_FILE">gateway</Property>
    <!-- 日志输出格式（含行号、类名、方法名等详细信息）
         注意：%M 和 %L 需要 includeLocation="true" 才能生效
         [reqId=%X{requestId}]：打印当前请求的 requestId（来自 MDC，由 ReactiveMdcConfiguration +
         RequestLoggingWebFilter 在请求生命周期内自动写入）；无请求上下文时（启动日志/定时任务）为空 -->
    <Property name="DETAIL_PATTERN">%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] [reqId=%X{requestId}] %-5level %c{2}.%M:%L - %msg%n%throwable</Property>
        <!-- 控制台输出格式（含方法名和行号）
             注意：%M 和 %L 需要 includeLocation="true" 才能生效 -->
        <Property name="CONSOLE_PATTERN">%highlight{%d{HH:mm:ss.SSS} [%t] [reqId=%X{requestId}] %-5level %c{1}.%M:%L - %msg%n%throwable}{FATAL=red blink, ERROR=red, WARN=yellow, INFO=green, DEBUG=cyan, TRACE=blue}</Property>
    </Properties>

    <Appenders>

        <!-- 控制台输出（带颜色高亮） -->
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="${CONSOLE_PATTERN}" />
        </Console>

        <!-- 滚动文件输出（详细格式，按天 + 按大小滚动）
             includeLocation="true" 确保 %M 和 %L 能正确输出方法名和行号 -->
        <RollingFile name="RollingFile"
                     fileName="${LOG_DIR}/${LOG_FILE}.log"
                     filePattern="${LOG_DIR}/archive/${LOG_FILE}-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="${DETAIL_PATTERN}" />
            <Policies>
                <!-- 每天滚动一次 -->
                <TimeBasedTriggeringPolicy interval="1" modulate="true" />
                <!-- 单文件超过 50MB 也滚动 -->
                <SizeBasedTriggeringPolicy size="50MB" />
            </Policies>
            <!-- 最多保留 30 个归档文件 -->
            <DefaultRolloverStrategy max="30">
                <Delete basePath="${LOG_DIR}/archive" maxDepth="2">
                    <IfFileName glob="*.log.gz" />
                    <IfLastModified age="30d" />
                </Delete>
            </DefaultRolloverStrategy>
        </RollingFile>

        <!-- 错误日志单独输出 -->
        <RollingFile name="ErrorFile"
                     fileName="${LOG_DIR}/${LOG_FILE}-error.log"
                     filePattern="${LOG_DIR}/archive/${LOG_FILE}-error-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="${DETAIL_PATTERN}" />
            <!-- 只输出 ERROR 及以上级别 -->
            <ThresholdFilter level="ERROR" onMatch="ACCEPT" onMismatch="DENY" />
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true" />
                <SizeBasedTriggeringPolicy size="50MB" />
            </Policies>
            <DefaultRolloverStrategy max="30" />
        </RollingFile>

    </Appenders>

    <Loggers>

        <!-- Spring Framework 日志级别 -->
        <Logger name="org.springframework" level="INFO" />
        <Logger name="org.springframework.web.reactive" level="INFO" />
        <Logger name="io.projectreactor.netty" level="INFO" />
        <Logger name="reactor.netty" level="INFO" />

        <!-- 屏蔽 ReactorNettyClient 的 INFO 日志（保留 WARN 及以上） -->
        <Logger name="io.asyncer.r2dbc.mysql.client.ReactorNettyClient" level="WARN" />
        <Logger name="dev.miku.r2dbc.mysql.client.ReactorNettyClient" level="WARN" />

        <!-- 网关业务日志：DEBUG 级别输出详细调试信息
             includeLocation="true" 确保 %M 和 %L 能正确输出方法名和行号 -->
        <Logger name="com.llmate.multiprotocol" level="DEBUG" includeLocation="true" />

        <!-- 根 Logger -->
        <Root level="INFO" includeLocation="true">
            <AppenderRef ref="Console" />
            <AppenderRef ref="RollingFile" />
            <AppenderRef ref="ErrorFile" />
        </Root>

    </Loggers>

</Configuration>
